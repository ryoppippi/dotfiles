{
  perSystem =
    {
      config,
      pkgs,
      lib,
      writeNu,
      ...
    }:
    let
      fishIndent = lib.getExe' pkgs.fish "fish_indent";
      gitleaks = lib.getExe pkgs.gitleaks;
      nufmt = lib.getExe pkgs.nufmt;
      oxfmt = lib.getExe pkgs.oxfmt;
      renovateConfigValidator = lib.getExe' pkgs.renovate "renovate-config-validator";
      treefmt = lib.getExe config.treefmt.build.wrapper;
    in
    {
      treefmt = {
        projectRootFile = "flake.nix";
        programs = {
          nixfmt = {
            enable = true;
            package = pkgs.nixfmt-rfc-style;
          };
          stylua.enable = true;
          shfmt.enable = true;
        };
        settings = {
          global.excludes = [
            ".git/**"
            "*.lock"
            # generated by nvimx-lock
            "nvim/nvimx-lock/**"
          ];
          formatter = {
            oxfmt = {
              command = oxfmt;
              options = [ "--no-error-on-unmatched-pattern" ];
              includes = [ "*" ];
              excludes = [
                "nvim/template/**"
              ];
            };
            renovate-validator = {
              command = renovateConfigValidator;
              options = [ "--strict" ];
              includes = [
                ".github/renovate.json5"
              ];
            };
            fish-indent = {
              command = fishIndent;
              options = [ "--write" ];
              includes = [ "*.fish" ];
            };
            nufmt = {
              command = nufmt;
              includes = [ "*.nu" ];
            };
          };
        };
      };

      pre-commit = {
        check.enable = false;
        settings.hooks = {
          gitleaks = {
            enable = true;
            entry = "${gitleaks} git --pre-commit --staged --redact=100 --verbose --no-color --no-banner";
            language = "system";
            pass_filenames = false;
            always_run = true;
          };
          treefmt = {
            enable = true;
            package = config.treefmt.build.wrapper;
          };
          deadnix.enable = true;
          statix.enable = true;
        };
      };

      apps.fmt = {
        type = "app";
        program = toString (
          writeNu "treefmt-wrapper" ''
            # --wrapped so unknown flags reach treefmt instead of being parsed
            # as flags to main.
            def --wrapped main [...rest] {
              exec ${treefmt} ...$rest
            }
          ''
        );
      };

      apps.gitleaks = {
        type = "app";
        program = gitleaks;
        meta.description = "Scan source code for secrets";
      };

      checks.gitleaks =
        pkgs.runCommand "gitleaks"
          {
            nativeBuildInputs = [ pkgs.gitleaks ];
            src = ../..;
          }
          ''
            cd "$src"
            gitleaks dir --redact=100 --verbose --no-color --no-banner .
            touch "$out"
          '';

      devShells.default = pkgs.mkShell {
        shellHook = ''
          ${config.pre-commit.installationScript}
        '';
      };
    };
}
