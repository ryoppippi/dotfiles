#!/usr/bin/env nix
#! nix shell nixpkgs#nushell --command nu --no-config-file
# pr-wait: watch one GitHub pull request and print one line per real event.
#
# Ported from t3dotgg/tstack's Python pr-wait (MIT). Stdout carries only events,
# one line each, so a monitor (Claude Code's Monitor tool) wakes the agent once
# per real event; progress and non-fatal errors go to stderr.
#
# Exit codes: 0 the --until condition is met or the PR merged; 1 it cannot be
# met without action (failed required check, conflict, closed PR, unresolved
# threads, BEHIND, GitHub unreachable); 2 bad input or another pr-wait already
# watches this PR.
#
# State lives in ~/.local/state/pr-wait/. The first run for a PR records what
# already exists and reports only what comes after; a restarted watcher reports
# what arrived while none ran.

const GATING_BOTS = [greptile macroscope]
const ADVISORY_BOTS = [coderabbit]
# CI and deploy bots report through checks; their PR comments are status noise.
const STATUS_BOTS = [github-actions vercel netlify railway cloudflare]
# Older state describes an old session: start a fresh baseline instead of
# replaying hours of comments as new events.
const STALE_STATE_SECONDS = 21600
const MAX_FAILED_POLLS = 10
const TRANSIENT = '(?i)HTTP (5\d\d|429)|rate limit|timed? ?out|connection (reset|refused)|EOF|temporar|could not resolve host|TLS handshake|Something went wrong'
const FAILED = [fail cancel]

# gh pr checks buckets, worst first. Duplicate names (push and pull_request runs
# of one job) collapse to the worst bucket.
const RANK = {
    fail: 4
    cancel: 3
    pending: 2
    pass: 1
    skipping: 0
}

const QUERY = 'query($owner: String!, $name: String!, $number: Int!) {
  viewer { login }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state headRefOid baseRefName mergeStateStatus
      author { login }
      baseRef { target { oid } }
      comments(last: 100) { nodes { id url body author { login __typename } } }
      reviews(last: 100) {
        nodes { id url state body commit { oid } author { login __typename } }
      }
      reviewThreads(last: 100) {
        nodes {
          isResolved path line
          comments(first: 100) { nodes { id url body author { login __typename } } }
        }
      }
    }
  }
}'

def state-dir [] {
    $env.HOME | path join .local state pr-wait
}

def log [message: string] { print -e $"pr-wait: ($message)" }

# Fatal messages go to stdout so a monitor shows the agent why it stopped.
def fail [message: string, code: int = 2] {
    print $"pr-wait: ($message)"
    exit $code
}

# Run gh, retrying transient failures (HTTP 5xx or 429, network) with backoff.
# Errors carry `transient` or `fatal` as their first word.
def gh [args: list<string>, --allow: list<int> = [0]] {
    mut delay = 2
    for attempt in 0..4 {
        let proc = do { ^gh ...$args } | complete
        let transient = $proc.exit_code != 0 and ($proc.stderr =~ $TRANSIENT)
        if (not $transient) and ($proc.exit_code in $allow) { return $proc }
        let lines = $proc.stderr | str trim | lines
        let message = if ($lines | is-empty) { $"gh exited ($proc.exit_code)" } else {
            $lines | last
        }
        if (not $transient) or $attempt == 4 {
            error make {msg: $"(if $transient { 'transient' } else { 'fatal' }) ($message)"}
        }
        log $"gh ($args | first 2 | str join ' '): ($message); retry in ($delay)s"
        sleep ($delay * 1sec)
        $delay = $delay * 2
    }
}

def gh-lines [args: list<string>] {
    gh $args | get stdout | lines | where $it != ''
}

def is-transient [err] {
    $err.msg | str starts-with 'transient '
}
def err-text [err] {
    $err.msg | str replace -r '^(transient|fatal) ' ''
}

# Which review bot a login or check name belongs to, or null.
def bot-name [text] {
    let lowered = $text | default '' | str lowercase
    $GATING_BOTS ++ $ADVISORY_BOTS | where {|bot| $lowered | str contains $bot } | get -o 0
}

def who [node] {
    let author = $node.author? | default {}
    {
        login: ($author.login? | default 'ghost')
        bot: ($author.__typename? == 'Bot')
    }
}

def plain [body] {
    $body
    | default ''
    | str replace -ar '(?s)<!--.*?-->' ' '
    | str replace -ar '<[^>]+>' ' '
    | str replace -a '&lt;' '<'
    | str replace -a '&gt;' '>'
    | str replace -a '&quot;' '"'
    | str replace -a '&#39;' "'"
    | str replace -a '&amp;' '&'
}

def snippet [body, limit: int = 100] {
    let text = plain $body | str replace -ar '\s+' ' ' | str trim
    if ($text | str length) <= $limit { $text } else { ($text | str substring 0..($limit - 4)) + '...' }
}

# The verdict line of a bot summary (Macroscope, Greptile), if it has one.
def verdict [body] {
    let line = plain $body | lines | where {|l| $l =~ '(?i)verdict|confidence score' } | get -o 0
    if $line == null { '' } else { snippet ($line | str replace -a '*' '') 80 }
}

def digest [body] {
    plain $body | str replace -ar '\s+' ' ' | hash sha256 | str substring 0..11
}

def parse-target [raw, repo] {
    if ($raw | default '' | str trim | is-empty) {
        fail 'missing PR number. Did a variable expand to nothing? Usage: pr-wait <pr> [--repo owner/name]'
    }
    let raw = $raw | str trim
    let url = $raw | parse -r '^https?://github\.com/(?<repo>[^/\s]+/[^/\s]+)/pull/(?<pr>\d+)(?:[/?#]\S*)?$'
    let num = $raw | parse -r '^#?(?<pr>\d+)$'
    let pr = if ($url | is-not-empty) {
        $url.0.pr | into int
    } else if ($num | is-not-empty) {
        $num.0.pr | into int
    } else {
        fail $"'($raw)' is not a PR number or PR URL"
    }
    if $pr <= 0 { fail $"'($raw)' is not a valid PR number" }
    let repo = if $repo != null {
        $repo
    } else if ($url | is-not-empty) {
        $url.0.repo
    } else {
        try {
            gh [
                repo
                view
                --json
                nameWithOwner
                --jq
                .nameWithOwner
            ] | get stdout | str trim
        } catch {|e| fail $"no --repo given and the current directory has no GitHub repo \((err-text $e)\)" }
    }
    if not ($repo =~ '^[\w.-]+/[\w.-]+$') { fail $"'($repo)' is not owner/name" }
    try {
        gh [
            pr
            view
            ($pr | into string)
            -R
            $repo
            --json
            number
        ]
    } catch {|e|
        # A transient failure is retried by the poll loop.
        if not (is-transient $e) { fail $"cannot read ($repo)#($pr): (err-text $e)" }
    }
    {repo: $repo, pr: $pr}
}

def key-of [repo: string, pr: int] { $"($repo | str replace '/' '__')__($pr)" }

# Hold a per-PR lock for the life of the process: a directory created
# atomically, holding our pid. A lock whose pid is gone is stale.
def take-lock [repo: string, pr: int] {
    let dir = state-dir
    mkdir $dir
    let lock = $dir | path join $"(key-of $repo $pr).lock"
    let taken = (do { ^mkdir $lock } | complete).exit_code == 0
    if not $taken {
        let pid = try {
            open ($lock | path join pid) | str trim
        } catch { '' }
        let alive = $pid != '' and ((do { ^kill -0 $pid } | complete).exit_code == 0)
        if $alive {
            fail $"pid ($pid) already watches ($repo)#($pr), so this watcher exits to avoid duplicate events. If no events reach you from it, run `kill ($pid)` and start again."
        }
    }
    $nu.pid | into string | save -f ($lock | path join pid)
}

# Required check names for the base branch, from rulesets and classic branch
# protection. Knowing them up front means a required check that has not started
# yet counts as pending, instead of green by omission.
def required-checks [repo: string, base: string] {
    let sources = [
        [path, jq];
        [$"repos/($repo)/rules/branches/($base)", '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context']
        [$"repos/($repo)/branches/($base)/protection/required_status_checks", '.contexts[]?, .checks[]?.context']
    ]
    $sources | each {|s|
    try { gh-lines [api $s.path --jq $s.jq] } catch {|e|
      # 404 means no protection, which is normal.
      if not ((err-text $e) | str contains 'HTTP 404') { log $"could not read required checks from ($s.path): (err-text $e)" }
      []
    }
  } | flatten | uniq
}

def load-state [path: string] {
    if not ($path | path exists) { return null }
    let age = ((date now) - (ls $path | get 0.modified)) / 1sec
    if $age > $STALE_STATE_SECONDS { return null }
    try { open $path } catch { null }
}

def save-state [w] {
    let tmp = $"($w.path).tmp"
    $w.state | merge {reported: ($w.reported | sort)} | to json | save -f $tmp
    mv -f $tmp $w.path
}

def say [w, line: string] {
    if $line in $w.printed { return $w }
    print $"#($w.pr) ($line)"
    $w | update printed { append $line }
}

# Print an event once per PR, across restarts.
def emit [w, key: string, line: string] {
    if $key in $w.reported { return $w }
    let w = $w | update reported { append $key }
    if $w.baseline { $w } else { say ($w | update events { $in + 1 }) $line }
}

def finish [w, code: int, lines: list<string> = []] {
    let w = $lines | reduce -f $w {|line, acc| say $acc $line }
    # A baseline that stopped before recording the PR would make the next run
    # report every existing comment as new. Let that run baseline again.
    if (not $w.baseline) or $w.recorded { save-state $w }
    exit $code
}

def fetch-pr [w] {
    let owner = $w.repo | split row '/' | get 0
    let name = $w.repo | split row '/' | get 1
    let data = gh [
        api
        graphql
        -f
        $"query=($QUERY)"
        -f
        $"owner=($owner)"
        -f
        $"name=($name)"
        -F
        $"number=($w.pr)"
    ] | get stdout | from json | get data
    $data.repository.pullRequest | insert viewer $data.viewer.login
}

def fetch-checks [w] {

    # gh pr checks exits 8 while checks are pending and 1 when one failed. Those
    # are states, not errors: read the JSON and ignore the exit code.
    let proc = gh [
        pr
        checks
        ($w.pr | into string)
        -R
        $w.repo
        --json
        'name,bucket,link,description'
    ] --allow [0 1 8]
    if ($proc.stdout | str trim | is-empty) {
        if ($proc.stderr | str contains 'no checks reported') { return {} }
        error make {msg: $"fatal (if ($proc.stderr | str trim | is-empty) { $'gh pr checks exited ($proc.exit_code)' } else { $proc.stderr | str trim })"}
    }
    $proc.stdout
    | from json
    | group-by name
    | transpose name rows
    | reduce -f {} {|g, acc| $acc | insert $g.name ($g.rows | sort-by {|r| $RANK | get -o $r.bucket | default 2 } | last) }
}

# Files this PR touches that the new base commits also touch.
def base-overlap [
    w
    head: string
    old: string
    new: string
] {
    try {
        let files = gh-lines [
            pr
            diff
            ($w.pr | into string)
            -R
            $w.repo
            --name-only
        ]
        let moved = gh-lines [
            api
            $"repos/($w.repo)/compare/($old)...($new)"
            --jq
            '.files[].filename'
        ]
        $files | where $it in $moved | sort
    } catch {|e|
        log $"could not compare base commits: (err-text $e)"
        []
    }
}

# How far the head is behind its base, for the green and ready lines.
def behind [
    w
    base: string
    base_oid
    head: string
] {
    if $base_oid == null { return '' }
    try {
        let count = gh [api $"repos/($w.repo)/compare/($base_oid)...($head)" --jq .behind_by] | get stdout | str trim
        $"; ($count) commit(if $count == '1' { '' } else { 's' }) behind ($base)"
    } catch { '' }
}

def poll [w] {
    let pr = fetch-pr $w
    if $pr.state == 'MERGED' { finish $w 0 [$"merged: ($pr.url)"] }
    if $pr.state == 'CLOSED' { finish $w 1 [$"closed without merging: ($pr.url)"] }

    let base = $pr.baseRefName
    mut w = $w
    if $w.required == null {
        let required = required-checks $w.repo $base
        let gate = if ($required | is-empty) { 'none set, so every CI check gates' } else {
            $required | sort | str join ', '
        }
        log $"watching ($w.repo)#($w.pr) until ($w.until); required checks: ($gate)"
        $w = $w | update required $required
    }
    let checks = fetch-checks $w
    let head = $pr.headRefOid
    let short = $head | str substring 0..6
    let mine = [
        (who $pr).login
        $pr.viewer
    ]
    let comments = $pr.comments.nodes
    let reviews = $pr.reviews.nodes
    let threads = $pr.reviewThreads.nodes
    $w = $w | update events 0

    # Required checks. With none configured, every CI check gates except the
    # review bots' own checks.
    let names = $checks | columns
    let gate = if ($w.required | is-empty) {
        $names | where {|n| (bot-name $n) == null }
    } else { $w.required }
    let label = if ($w.required | is-empty) { 'check' } else { 'required check' }
    let bucket = {|name|
        if $name in $names {
            $checks | get $name | get bucket
        } else { 'pending' }
    }

    mut fail_lines = []
    for name in ($gate | sort) {
        if (do $bucket $name) in $FAILED {
            let link = $checks | get $name | get link
            let line = $"($label) failed: ($name) ($link)"
            $fail_lines = $fail_lines | append $line
            $w = emit $w $"fail:($head):($name):($link)" $line
        }
    }
    let watched = $names | where {|n| (bot-name $n) not-in $ADVISORY_BOTS }
    let gate_done = ($gate | is-not-empty) and ($gate | all {|n| (do $bucket $n) != 'pending' })
    let all_done = $gate_done and ($watched | all {|n| ($checks | get $n | get bucket) != 'pending' })
    # Checks appear a few seconds after a push. Two identical polls in a row guard
    # against calling a half-registered set of checks finished.
    let snapshot = $watched | sort | each {|n| $"($n)=($checks | get $n | get bucket)" }
    let stable = $snapshot == $w.prev_snapshot
    $w = $w | update prev_snapshot $snapshot
    let green = $gate_done and $stable and ($fail_lines | is-empty)

    # People and bots talking. Edits are never events.
    for c in $comments {
        let a = who $c
        if $a.login in $mine or (bot-name $a.login) != null or ($a.bot and ($STATUS_BOTS | any {|b| $a.login | str contains $b })) { continue }
        $w = (emit
            $w
            $"c:($c.id)"
            $"comment from ($a.login): (snippet $c.body) ($c.url)"
        )
    }
    for r in $reviews {
        let a = who $r
        if $a.login in $mine or $a.bot { continue }
        if $r.state in [APPROVED CHANGES_REQUESTED] or ($r.body | str trim | is-not-empty) {
            let state = $r.state | str lowercase | str replace -a '_' ' '
            $w = (emit
                $w
                $"c:($r.id)"
                $"review from ($a.login) \(($state)\): (snippet $r.body) ($r.url)"
            )
        }
    }
    mut unresolved = []
    for t in $threads {
        let nodes = $t.comments.nodes
        if (not $t.isResolved) and ($nodes | is-not-empty) { $unresolved = $unresolved | append $nodes.0.url }
        let where_ = if $t.line != null { $"($t.path):($t.line)" } else { $t.path }
        for item in ($nodes | enumerate) {
            let a = who $item.item
            if $a.login in $mine { continue }
            let kind = if $item.index == 0 { 'new thread' } else { 'thread reply' }
            $w = (emit
                $w
                $"c:($item.item.id)"
                $"($kind) from ($a.login) on ($where_): (snippet $item.item.body) ($item.item.url)"
            )
        }
    }

    # Review bots on the current head. A bot with checks is done when they finish;
    # otherwise once it reviews the head commit or its summary names the head.
    mut bot_status = {}
    mut reviewed = []
    for bot in ($GATING_BOTS ++ $ADVISORY_BOTS) {
        let own_checks = $names | where {|n| (bot-name $n) == $bot }
        let summaries = $comments | where {|c| (bot-name (who $c).login) == $bot }
        let own_reviews = $reviews | where {|r| (bot-name (who $r).login) == $bot }
        let on_head = $own_reviews | any {|r| $r.commit?.oid? == $head }
        let done = if ($own_checks | is-not-empty) {
            $own_checks | all {|n| ($checks | get $n | get bucket) != 'pending' }
        } else {
            $on_head or ($summaries | any {|s| $s.body | str contains $short })
        }
        let seen = ($own_checks | is-not-empty) or ($summaries | is-not-empty) or ($own_reviews | is-not-empty)
        let advisory = $bot in $ADVISORY_BOTS
        if $advisory and ($own_checks | is-not-empty) {
            let desc = $checks | get ($own_checks | first)
            $bot_status = $bot_status | upsert $bot $"($bot) ($desc.description | default '' | if ($in | is-empty) { $desc.bucket } else { $in }) \(advisory\)"
        } else if $seen {
            $bot_status = $bot_status | upsert $bot $"($bot) (if $done { 'done' } else { 'pending' })(if $advisory { ' (advisory)' } else { '' })"
        }
        let key = $"bot:($bot):($head)"
        let was_done = $key in $w.reported
        if $done {
            if not $advisory { $reviewed = $reviewed | append $bot }
            let failed = $own_checks | where {|n| ($checks | get $n | get bucket) in $FAILED }
            let v = $summaries | each {|s| verdict $s.body } | where $it != '' | get -o 0 | default ''
            let detail = [
                $v
                (
                    if ($failed | is-empty) { '' } else { $"failed: ($failed | str join ', ')" }
                )
            ] | where $it != '' | str join '; '
            let tag = if $advisory { ' (advisory, not waited on)' } else { '' }
            $w = (emit
                $w
                $key
                $"($bot) finished on ($short)(if $detail == '' { '' } else { $': ($detail)' })($tag)"
            )
        }
        if not $advisory {
            for s in $summaries {
                let new = digest $s.body
                let old = $w.state.summaries | get -o $s.id
                $w = $w | update state.summaries { upsert $s.id $new }
                if $was_done and $old != null and $old != $new {
                    let text = verdict $s.body | if ($in | is-empty) { snippet $s.body } else { $in }
                    $w = (emit
                        $w
                        $"summary:($s.id):($new)"
                        $"($bot) summary changed on ($short): ($text) ($s.url)"
                    )
                }
            }
        }
    }

    # Base branch and merge state.
    let base_oid = $pr.baseRef?.target?.oid?
    let old_base = $w.state.base_oid
    if $base_oid != null and $old_base != null and $base_oid != $old_base and (not $w.baseline) {
        let touched = base-overlap $w $head $old_base $base_oid
        if ($touched | is-not-empty) {
            let more = if ($touched | length) > 5 { $" and (($touched | length) - 5) more" } else { '' }
            $w = (emit
                $w
                $"base:($base_oid)"
                $"($base) moved to ($base_oid | str substring 0..6) and touches files in this PR: ($touched | first 5 | str join ', ')($more)"
            )
        }
    }
    if $base_oid != null { $w = $w | update state.base_oid $base_oid }
    let merge_state = $pr.mergeStateStatus
    let dirty_line = $"merge state is DIRTY: the branch conflicts with ($base), rebase it"
    let behind_line = $"merge state is BEHIND: update the branch from ($base) before merging"
    if $merge_state != 'UNKNOWN' {
        if $merge_state in [BEHIND DIRTY] and $w.state.merge_state != $merge_state {
            $w = (emit
                $w
                $"merge:($merge_state):($head):($base_oid)"
                (if $merge_state == 'DIRTY' { $dirty_line } else { $behind_line })
            )
        }
        $w = $w | update state.merge_state $merge_state
    }

    # One summary line per head once all checks finish.
    let counts = $watched | each {|n| $checks | get $n | get bucket } | uniq -c | sort-by value
    let failed_names = $watched | where {|n| ($checks | get $n | get bucket) in $FAILED } | sort
    let req_green = $w.required | where {|n| (do $bucket $n) in [pass skipping] } | length
    let status = $bot_status
    let bots = $GATING_BOTS ++ $ADVISORY_BOTS | where {|b| $b in ($status | columns) } | each {|b| $status | get $b }
    let parts = [
        (
            ($counts | each {|c| $"($c.count) ($c.value)" } | str join ', ') + (
                if ($failed_names | is-empty) { '' } else { $" \(($failed_names | str join ', ')\)" }
            )
        )
        (
            if ($w.required | is-empty) { '' } else { $"required ($req_green)/($w.required | length) green" }
        )
        (
            if ($bots | is-empty) { 'no Greptile or Macroscope yet' } else {
                $bots | str join ', '
            }
        )
        $"($unresolved | length) unresolved threads"
        $"merge state ($merge_state)"
    ]
    let summary = $parts | where $it != '' | str join '; '
    let checks_key = $"checks:($head)"
    # Every comment, review, thread, bot, base and merge-state event is recorded.
    $w = $w | update recorded true

    # Decide whether to stop. A green or ready line carries the same summary as
    # the checks line, so it marks that event as reported.
    if $w.until != 'any-change' {
        if $merge_state == 'DIRTY' { finish $w 1 [$dirty_line] }
        if ($fail_lines | is-not-empty) { finish $w 1 $fail_lines }
        if $green and $w.until == 'green' {
            (finish
                ($w | update reported { append $checks_key })
                0
                [
                    $"green on ($short): ($summary)(behind $w $base $base_oid $head)"
                ]
            )
        }
        # ready waits for Greptile or Macroscope, never for CodeRabbit.
        if $green and ($reviewed | is-not-empty) {
            if ($unresolved | is-not-empty) {
                (finish
                    $w
                    1
                    [
                        $"blocked by ($unresolved | length) unresolved threads on ($short): ($unresolved | str join ' ')"
                    ]
                )
            }
            if $merge_state == 'BEHIND' { finish $w 1 [$behind_line] }
            (finish
                ($w | update reported { append $checks_key })
                0
                [
                    $"ready on ($short): ($summary)(behind $w $base $base_oid $head)"
                ]
            )
        }
    }
    if $all_done and ($stable or $w.baseline) {
        $w = emit $w $checks_key $"checks finished on ($short): ($summary)"
    }
    if $w.until == 'any-change' and $w.events > 0 { finish $w 0 }
    $w
}

# Watch a GitHub PR and print one line per real event.
def main [
  pr?: string          # PR number or URL
  --repo: string       # owner/name (default: from the URL or the current checkout)
  --until: string = 'ready' # green, ready, or any-change
  --interval: int = 20 # seconds between polls (min 5)
] {
    if $until not-in [green ready any-change] { fail $"--until must be green, ready, or any-change, not '($until)'" }
    let target = parse-target $pr $repo
    take-lock $target.repo $target.pr
    let path = state-dir | path join $"(key-of $target.repo $target.pr).json"
    let state = load-state $path
    mut w: record = {
        repo: $target.repo
        pr: $target.pr
        until: $until
        path: $path
        # First run for this PR: record what exists and report nothing.
        baseline: ($state == null)
        state: (
            $state
            | default { reported: [], summaries: {}, base_oid: null, merge_state: null }
        )
        reported: ($state.reported? | default [])
        printed: []
        recorded: false
        events: 0
        required: null
        prev_snapshot: null
    }
    mut failures = 0
    loop {
        let result = try {
            {
                ok: (poll $w)
            }
        } catch {|e| {err: $e} }
        if 'ok' in $result {
            $w = $result.ok
            $failures = 0
            save-state $w
            if $w.baseline { log $"baseline recorded for ($w.repo)#($w.pr); reporting only new events" }
            $w = $w | update baseline false
        } else {
            let e = $result.err
            if not (is-transient $e) { finish $w 1 [$"pr-wait stopped: (err-text $e)"] }
            $failures = $failures + 1
            log $"poll failed \(($failures)/($MAX_FAILED_POLLS)\): (err-text $e)"
            if $failures >= $MAX_FAILED_POLLS {
                (finish
                $w
                1
                [
                    $"pr-wait stopped: GitHub unreachable for ($failures) polls: (err-text $e)"
                ]
            )
            }
        }
        sleep (([$interval 5] | math max) * 1sec)
    }
}
